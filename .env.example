# TopoAgent Environment Variables
# Copy this file to .env and fill in your API keys

# OpenAI (for GPT-4o)
OPENAI_API_KEY=your-openai-api-key

# Model selection (default: gpt-4o)
OPENAI_MODEL=gpt-4o

# Anthropic (for Claude models, optional)
ANTHROPIC_API_KEY=your-anthropic-api-key

# Google (for Gemini models, optional)
GOOGLE_API_KEY=your-google-api-key

# ============== Dataset locations (only for benchmark reproduction) ==============
# The agent itself needs none of these; they are read by the benchmark code.
# MEDMNIST_PATH=~/.medmnist
# EXTERNAL_DATASETS_ROOT=/path/to/datasets
# ISIC_PATH=/path/to/isic2019/train
# KVASIR_PATH=/path/to/kvasir-dataset
# DRIVE_ROOT=/path/to/DRIVE
# CUPH_PATH=/path/to/CuPH        # optional GPU persistent-homology backend
